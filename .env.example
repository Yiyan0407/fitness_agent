# 应用访问密码（留空则不启用登录门禁）
APP_PASSWORD=1123
# 可选：记住设备用的签名密钥（不填则用 APP_PASSWORD 派生）
# APP_AUTH_SECRET=

# 教练对话 / 文字饮食记账（小米 MiMo）
MIMO_API_KEY=sk-xxxxx

# 饮食拍照识别（火山方舟 · 豆包视觉）
# 控制台：https://console.volcengine.com/ark
DOUBAO_API_KEY=
# 模型名或推理接入点 ID（ep-xxxx）
DOUBAO_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

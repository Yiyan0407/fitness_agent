# 应用访问密码（留空则不启用登录门禁）
APP_PASSWORD=1123
# 可选：记住设备用的签名密钥（不填则用 APP_PASSWORD 派生）
# APP_AUTH_SECRET=

# 小米 MiMo（教练对话 + 文字记账 + 饮食拍照，同一 Key）
# 平台：https://platform.xiaomimimo.com
MIMO_API_KEY=sk-xxxxx
# 教练默认模型
# MIMO_MODEL=mimo-v2.5-pro
# 看图模型（官方图像理解：mimo-v2.5）
# MIMO_VISION_MODEL=mimo-v2.5
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
